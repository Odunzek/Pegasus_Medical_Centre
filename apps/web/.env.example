# Copy to apps/web/.env.local and fill in. Never commit .env.local.
# Every variable the site reads or will read is listed here, with who sets it.

# ---- Always ----
# The site's public origin, no trailing slash. Used for canonical URLs, hreflang, sitemap and structured data.
# Local: http://localhost:3000. Vercel production: the canonical domain (launch checklist A1).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show draft records with a "Draft" mark. Read at BUILD time (the value is baked into the static pages).
# Local development and Vercel preview deployments: true. Production: unset.
SHOW_DRAFTS=true

# ---- Sanity (once the clinic's project exists; the Sanity chunk) ----
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Shared secret between the Sanity publish webhook and the site's revalidate route (not built yet).
SANITY_REVALIDATE_SECRET=

# ---- Enquiry form (the contact chunk; not read by any code yet) ----
# The form service endpoint the Contact form posts to (launch checklist A5).
FORM_ENDPOINT=

# ---- Analytics (launch checklist A6; not read by any code yet) ----
NEXT_PUBLIC_GA4_ID=

# ---- Set by tooling, not by people ----
# VERCEL_ENV: "preview" | "production", set by Vercel; robots.ts disallows crawling on previews.
# CHECK_PRODUCTION=1: makes `npm run check` refuse temporary photos; the production build command sets it
#   (npm run check:production). SMOKE_BASE_URL: point the smoke test at an already-running site instead of
#   starting one (npm run smoke).
