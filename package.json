{
  "name": "pegasus-medical-centre",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "lint": "npm run lint -w apps/web",
    "typecheck": "npm run typegen -w apps/web && tsc --noEmit -p apps/web/tsconfig.json",
    "studio": "npm run dev -w apps/studio",
    "check": "node scripts/check-facts.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "playwright": "^1.56.0"
  }
}
